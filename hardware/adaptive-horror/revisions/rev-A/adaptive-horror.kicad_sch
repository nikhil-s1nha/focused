(text "BENCH CONFIGURATION ONLY" (at 20.32 22.86 0) (effects (font (size 2.4 2.4)) (justify left)) (uuid "8ba8c714-9660-541e-b60d-7a01be94f818"))
(text "Existing LOGIC_SEL = 5 V (continuity checked). Uno R3 uses 5 V logic." (at 20.32 33.02 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "9acfb77c-66de-5bdd-9209-3aa3677f7dd5"))
(text "ELECTRODES: LEAVE DISCONNECTED during USB/mains bench tests." (at 20.32 154.94 0) (effects (font (size 1.7 1.7)) (justify left)) (uuid "ba4e4ae7-8195-5dbf-a79e-ccedbbfd3965"))
(text "Cable contact names shown only. Lead colors and skin placements are UNVERIFIED." (at 20.32 165.1 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "94f10471-6923-5000-b4f1-16472531c965"))
(text "The ADS1292R board is sold for ECG/respiration; EEG suitability is not yet validated." (at 20.32 172.72 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e308a2f5-df51-5a17-bfbe-ef261c447f0d"))
(text "Before body use: isolated battery acquisition and a reviewed wireless data path are required." (at 20.32 180.34 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "615d5d80-1dad-54bc-ae8c-d923283d076a"))
(text "Do not treat a battery-powered Pi connected to mains USB/HDMI peripherals as isolated." (at 20.32 187.96 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5b2b452c-64dd-525a-b306-885f04c4b5c7"))
(text "No extra Uno barrel-jack / VIN supply in this USB-powered bench configuration." (at 20.32 198.12 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6fdd42c1-d073-5c5d-bbfb-944621222396"))
(text "CHECK BEFORE POWER: each header pin has its own breadboard strip; no adjacent-pin shorts." (at 20.32 210.82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6a0e4110-49bd-5b2f-82d2-6ab4ee8426df"))
(text "Firmware: CS=D7, DRDY=D6, START=D5, RESET=D4. Keep Uno D10 configured as OUTPUT for SPI master." (at 20.32 218.44 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "2ab749f3-7ce5-589b-8d94-e60d34b6f386"))
