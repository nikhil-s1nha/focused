# Set privately in your shell. Node does not automatically load this file.
SIGNAL_TOKEN=replace-with-a-private-random-token-at-least-24-characters
# Preserve your existing HOST, PORT, TLS_CERT and TLS_KEY configuration.
# SIGNAL_URL is for the Python sender on the sensor laptop:
SIGNAL_URL=http://GAME_LAPTOP_LAN_IP:GAME_PORT/signal-link/event
